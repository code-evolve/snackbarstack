    "@babel/preset-env": "^7.29.7",
    "babel-loader": "^9.2.1",
    "css-loader": "^6.11.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "style-loader": "^3.3.4",
    "vue": "^2.7.16",
